---
import type { CollectionEntry } from 'astro:content';
interface Props {
  entry: CollectionEntry<'experiences'>;
}
const { entry } = Astro.props;
const { org, role, dates, summary, highlights, tbd } = entry.data;
---

<div class="exp" data-reveal id={entry.id}>
  <div class="exp__meta">
    <p class="exp__dates">{dates}</p>
    {
      tbd.length > 0 && (
        <ul class="exp__tbd hand" aria-label="Notes still to confirm">
          {tbd.map((t) => (
            <li>{t}</li>
          ))}
        </ul>
      )
    }
  </div>
  <div class="exp__body">
    <p class="exp__org eyebrow">{org}</p>
    <h3 class="exp__role">{role}</h3>
    <p class="exp__summary">{summary}</p>
    {
      highlights.length > 0 && (
        <ul class="exp__list">
          {highlights.map((h) => (
            <li>{h}</li>
          ))}
        </ul>
      )
    }
  </div>
</div>

<style>
  .exp {
    display: grid;
    gap: 0.6rem 2rem;
    padding-top: 1.6rem;
    border-top: 2.5px solid var(--ink);
  }
  @media (min-width: 760px) {
    .exp {
      grid-template-columns: 220px 1fr;
    }
  }
  .exp__dates {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.3rem;
    letter-spacing: -0.02em;
    color: var(--magenta);
    margin: 0;
  }
  .exp__tbd {
    list-style: none;
    padding: 0.5rem 0.8rem;
    margin: 0.8rem 0 0;
    background: #fff4b8;
    color: #3a2a10;
    font-size: 1.15rem;
    line-height: 1.2;
    rotate: -2deg;
    box-shadow: 2px 3px 0 rgba(0, 0, 0, 0.15);
    max-width: 220px;
  }
  .exp__tbd li + li {
    margin-top: 0.3rem;
  }
  .exp__org {
    margin: 0;
  }
  .exp__role {
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    margin: 0.3rem 0 0.6rem;
  }
  .exp__summary {
    font-size: 1.1rem;
    max-width: 60ch;
  }
  .exp__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
    max-width: 62ch;
  }
  .exp__list li {
    position: relative;
    padding-left: 1.6rem;
  }
  .exp__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.65em;
    height: 0.65em;
    border: 2px solid var(--magenta);
    rotate: 45deg;
    border-radius: 2px;
  }
</style>
