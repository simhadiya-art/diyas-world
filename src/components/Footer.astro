---
import JewelMark from './JewelMark.astro';
import KolamBorder from './KolamBorder.astro';
const year = new Date().getFullYear();
---

<footer class="footer">
  <KolamBorder />
  <div class="wrap footer__inner">
    <span class="footer__mark" aria-hidden="true"><JewelMark size={64} strokeWidth={1.8} /></span>
    <div class="footer__text">
      <p class="footer__big">Still reading? <span class="serif">Then we should talk.</span></p>
      <p>
        <a href="/mailroom">Write to the Mailroom</a> ·
        <a href="mailto:simhadiya@gmail.com">simhadiya@gmail.com</a> ·
        <a href="https://www.linkedin.com/in/diyasimha" rel="noopener" target="_blank">LinkedIn</a>
      </p>
      <p class="muted small">© {year} Diya Simha. Built loud, on purpose.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: 4rem;
    padding-bottom: 2.5rem;
  }
  .footer__inner {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    padding-top: 2rem;
  }
  .footer__mark {
    border: none;
    background: none;
    padding: 0;
    color: var(--magenta);
    flex: none;
  }
  .footer__big {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: 0.6rem;
  }
  .footer__big .serif {
    color: var(--magenta);
    font-weight: 400;
  }
  .footer a {
    font-weight: 600;
    text-decoration-color: var(--saffron);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  .small {
    font-size: 0.85rem;
  }
</style>

