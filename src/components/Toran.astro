---
// A toran (the garland strung over a doorway) with jewel drops and city tags.
// Charms swing when you brush past them; tags link to each city.
import { getCollection } from 'astro:content';

const places = (await getCollection('places')).sort((a, b) => a.data.order - b.data.order);
const tones = ['gold', 'ruby', 'sapphire', 'emerald'];

type Charm =
  | { kind: 'gem'; tone: string; len: number }
  | { kind: 'tag'; tone: string; len: number; name: string; href: string };

const charms: Charm[] = [];
places.forEach((p, i) => {
  charms.push({ kind: 'gem', tone: tones[(i * 2 + 1) % tones.length], len: 16 + (i % 2) * 18 });
  charms.push({ kind: 'tag', tone: tones[i % tones.length], len: i % 2 ? 66 : 22, name: p.data.name, href: `/places/${p.id}` });
});
charms.push({ kind: 'gem', tone: 'ruby', len: 28 });

/** Scalloped rope through evenly spaced anchors (viewBox 1000 × 40, anchors at y = 6). */
function rope(n: number) {
  const xs = Array.from({ length: n }, (_, i) => ((i + 0.5) / n) * 1000);
  let d = `M0 2Q${xs[0] / 2} 22 ${xs[0]} 6`;
  for (let i = 1; i < n; i++) d += `Q${(xs[i - 1] + xs[i]) / 2} 34 ${xs[i]} 6`;
  return d + `Q${(xs[n - 1] + 1000) / 2} 22 1000 2`;
}
const ropeAll = rope(charms.length);
const ropeTags = rope(places.length);
---

<section class="toran" aria-label="Places I've lived" data-toran>
  {
    [
      ['toran__rope--all', ropeAll],
      ['toran__rope--tags', ropeTags],
    ].map(([cls, d]) => (
      <svg class:list={['toran__rope', cls]} viewBox="0 0 1000 40" preserveAspectRatio="none" aria-hidden="true">
        <path d={d} class="toran__cord" vector-effect="non-scaling-stroke" />
        <path d={d} class="toran__beads" vector-effect="non-scaling-stroke" />
      </svg>
    ))
  }
  <ul class="toran__charms">
    {
      charms.map((c) => (
        <li class:list={['charm', `charm--${c.kind}`, `tone-${c.tone}`]} style={`--len:${c.len}px`} aria-hidden={c.kind === 'gem' ? 'true' : undefined}>
          <div class="charm__swing" data-swing data-len={c.len}>
            <span class="charm__string" />
            {c.kind === 'tag' ? (
              <a class="charm__tag" href={c.href}>
                {c.name}
              </a>
            ) : (
              <svg class="charm__gem" viewBox="0 0 24 46" width="24" height="46">
                <circle cx="12" cy="4" r="3.2" class="charm__pearl" />
                <path class="facet-1" d="M12 9L4 19L12 34Z" />
                <path class="facet-2" d="M12 9L20 19L12 34Z" />
                <path d="M12 9L4 19L12 34L20 19Z M4 19H20" class="charm__edge" />
                <path d="M12 34V44M9.6 34.6L8.4 42.5M14.4 34.6L15.6 42.5" class="charm__tassel" />
              </svg>
            )}
          </div>
        </li>
      ))
    }
  </ul>
  <p class="toran__note hand" aria-hidden="true">(give them a swing)</p>
</section>

<style>
  .toran {
    position: relative;
    padding: 1.4rem 0 1rem;
    min-height: 190px;
    overflow: hidden;
  }
  .toran__rope {
    display: block;
    width: 100%;
    height: 40px;
    overflow: visible;
  }
  .toran__cord {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2;
  }
  .toran__beads {
    fill: none;
    stroke: var(--saffron);
    stroke-width: 7;
    stroke-linecap: round;
    stroke-dasharray: 0 13;
  }
  .toran__rope--tags {
    display: none;
  }
  .toran__charms {
    position: absolute;
    top: calc(1.4rem + 6px);
    left: 0;
    right: 0;
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .charm {
    flex: 1 1 0;
    display: flex;
    justify-content: center;
    min-width: 0;
  }
  .charm__swing {
    display: flex;
    flex-direction: column;
    align-items: center;
    transform-origin: 50% 0;
    will-change: transform;
  }
  .charm__string {
    width: 1.5px;
    height: var(--len);
    background: var(--ink);
  }
  .charm__tag {
    position: relative;
    padding: 0.85rem 0.85rem 0.45rem;
    margin-top: -2px;
    background: color-mix(in oklab, var(--g) 22%, var(--bg));
    color: var(--ink);
    border: 2px solid var(--ink);
    border-radius: 8px 8px 10px 10px;
    box-shadow: 3px 3px 0 var(--g);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(0.8rem, 0.7rem + 0.5vw, 1.1rem);
    letter-spacing: -0.01em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 0.2s,
      box-shadow 0.25s var(--spring);
  }
  /* the punched hole the string goes through */
  .charm__tag::before {
    content: '';
    position: absolute;
    top: 4px;
    left: 50%;
    width: 7px;
    height: 7px;
    margin-left: -3.5px;
    border-radius: 50%;
    background: var(--bg);
    border: 1.5px solid var(--ink);
  }
  .charm__tag:hover,
  .charm__tag:focus-visible {
    background: var(--g);
    color: var(--on-saffron);
    box-shadow: 5px 5px 0 var(--ink);
  }
  .charm__gem {
    margin-top: -2px;
    overflow: visible;
  }
  .charm__pearl {
    fill: color-mix(in oklab, var(--bg) 40%, white);
    stroke: var(--ink);
    stroke-width: 1.2;
  }
  .charm__edge {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.3;
    stroke-linejoin: round;
  }
  .charm__tassel {
    fill: none;
    stroke: var(--saffron);
    stroke-width: 1.4;
    stroke-linecap: round;
  }
  .toran__note {
    position: absolute;
    right: var(--gutter);
    bottom: 0.2rem;
    margin: 0;
    font-size: 1.3rem;
    color: var(--teal);
    rotate: -3deg;
  }

  @media (max-width: 699px) {
    .toran__rope--all,
    .charm--gem {
      display: none;
    }
    /* inset so the end tags don't hang off the screen */
    .toran__rope--tags {
      display: block;
      width: auto;
      margin-inline: 2.25rem;
    }
    .toran__charms {
      left: 2.25rem;
      right: 2.25rem;
    }
    .charm__tag {
      font-size: 0.72rem;
      padding: 0.75rem 0.55rem 0.35rem;
    }
    .toran__note {
      display: none;
    }
  }
</style>

<script>
  import { reducedMotion } from '../scripts/motion';

  const root = document.querySelector<HTMLElement>('[data-toran]');
  if (root && !reducedMotion()) {
    // Each charm is a damped pendulum (angle in degrees). Longer strings swing slower.
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-swing]')).map((el) => {
      const len = Number(el.dataset.len) || 30;
      return { el, a: 0, v: 0, k: 0.9 / (len + 45) };
    });
    let running = false;
    const clamp = (n: number, m: number) => Math.max(-m, Math.min(m, n));

    const tick = () => {
      let energy = 0;
      for (const it of items) {
        it.v = (it.v - it.k * it.a) * 0.975;
        it.a += it.v;
        energy += Math.abs(it.a) + Math.abs(it.v);
        it.el.style.transform = `rotate(${it.a.toFixed(2)}deg)`;
      }
      if (energy > 0.08) requestAnimationFrame(tick);
      else {
        running = false;
        for (const it of items) {
          it.a = it.v = 0;
          it.el.style.transform = '';
        }
      }
    };
    const kick = () => {
      if (running) return;
      running = true;
      requestAnimationFrame(tick);
    };

    // brush past a charm and it swings the way you pushed it
    let last = { x: 0, t: 0 };
    root.addEventListener('pointermove', (e) => {
      const now = performance.now();
      const vx = ((e.clientX - last.x) / Math.max(8, now - last.t)) * 16;
      last = { x: e.clientX, t: now };
      let hit = false;
      for (const it of items) {
        const r = it.el.getBoundingClientRect();
        if (!r.width) continue;
        if (e.clientX > r.left - 8 && e.clientX < r.right + 8 && e.clientY > r.top + 10 && e.clientY < r.bottom + 10) {
          it.v = clamp(it.v - vx * 0.18, 5);
          hit = true;
        }
      }
      if (hit) kick();
    });
    root.addEventListener('pointerdown', (e) => {
      const el = (e.target as Element).closest<HTMLElement>('[data-swing]');
      const it = items.find((i) => i.el === el);
      if (!it) return;
      it.v += (Math.random() > 0.5 ? 1 : -1) * 4;
      kick();
    });

    // a breeze when it first comes into view
    new IntersectionObserver(
      ([entry], io) => {
        if (!entry.isIntersecting) return;
        io.disconnect();
        items.forEach((it, i) => (it.v = Math.sin(i * 1.7) * 2.2));
        kick();
      },
      { threshold: 0.4 },
    ).observe(root);
  }
</script>
