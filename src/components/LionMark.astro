---
import { FACE, PETAL, PETAL_VEIN, LION_CENTER, petalAngles } from '../lib/lion';

interface Props {
  size?: number | string;
  strokeWidth?: number;
  class?: string;
  title?: string;
}
const { size = 40, strokeWidth = 2.2, class: className, title } = Astro.props;
const { x, y } = LION_CENTER;
---

<svg
  class:list={['lion-mark', className]}
  viewBox="0 0 100 100"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
>
  {title && <title>{title}</title>}
  <g class="lm-mane">
    {
      petalAngles.map((a) => (
        <g transform={`rotate(${a} ${x} ${y})`}>
          <path class="lm-petal" d={PETAL} />
          <path class="lm-vein" d={PETAL_VEIN} stroke-width={strokeWidth * 0.6} />
        </g>
      ))
    }
  </g>
  <g class="lm-face">
    {FACE.map((d) => <path d={d} />)}
  </g>
</svg>
