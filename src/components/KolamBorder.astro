---
// A repeating cut-gem jaali border.
interface Props {
  color?: string;
  units?: number;
}
const { color = 'var(--magenta)', units = 48 } = Astro.props;
const step = 36;
const mid = 22;
const centers = Array.from({ length: units }, (_, i) => i * step + step / 2);
---

<div class="kolam-border" aria-hidden="true">
  <svg viewBox={`0 0 ${units * step} 44`} width={units * step} height="44" fill="none" stroke={color} stroke-width="2" stroke-linecap="round">
    {centers.map((x) => (
      <>
        <path d={`M${x} 4L${x + 18} ${mid}L${x} 40L${x - 18} ${mid}Z`} data-draw />
        <path d={`M${x} 14L${x + 8} ${mid}L${x} 30L${x - 8} ${mid}Z`} data-draw />
        <circle cx={x} cy={mid} r="2" fill={color} stroke="none" />
      </>
    ))}
  </svg>
</div>

<style>
  .kolam-border {
    overflow: hidden;
    display: flex;
    justify-content: center;
    opacity: 0.85;
  }
  .kolam-border svg {
    flex: none;
    max-width: none;
  }
</style>
