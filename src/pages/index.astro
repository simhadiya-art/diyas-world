---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import JewelMark from '../components/JewelMark.astro';
import KolamBorder from '../components/KolamBorder.astro';
import Door from '../components/Door.astro';
import JeweledLion from '../components/JeweledLion.astro';
import Toran from '../components/Toran.astro';
import headshot from '../assets/images/diya-headshot.jpg';

const projects = await getCollection('projects');
const featured = projects.sort((a, b) => a.data.order - b.data.order)[0];

const doors = [
  { href: '/map', name: 'The Map Room', line: 'Five cities, one dotted line, a lot of carry-on luggage.', color: 'teal', symbol: 'map' },
  { href: '/mailroom', name: 'The Mailroom', line: 'Where you write to me. I write back. Usually fast.', color: 'saffron', symbol: 'mail' },
  { name: 'The Studio', line: 'Sewing and sketchbooks. Currently pinned together with safety pins.', color: 'magenta', symbol: 'needle' },
  { name: 'The Dance Floor', line: 'Rehearsing. Please do not look directly at the choreography yet.', color: 'saffron', symbol: 'music' },
  { name: 'The Deep End', line: 'Swimming. Still filling the pool. Bring goggles.', color: 'teal', symbol: 'wave' },
  { name: 'Character Profile', line: 'Fun facts, strong opinions and one very good dosa recommendation.', color: 'magenta', symbol: 'star' },
] as const;
---

<Base>
  <!-- First-visit intro: the jewel draws itself, then the world opens. -->
  <div class="intro" id="intro" aria-hidden="true">
    <div class="intro__jewel"><JewelMark size={220} strokeWidth={1.6} /></div>
    <p class="intro__line serif">entering Diya's world…</p>
    <button class="intro__skip" type="button" data-skip-intro>Skip intro →</button>
  </div>
  <script is:inline>
    try {
      if (!localStorage.getItem('dw-intro') && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('show-intro');
      }
    } catch (e) {}
  </script>

  <section class="hero" aria-labelledby="hero-title">
    <canvas class="hero__field" aria-hidden="true"></canvas>
    <div class="hero__lion">
      <JeweledLion />
    </div>
    <div class="hero__copy wrap">
      <p class="eyebrow hero__eyebrow"><span class="dot"></span> Diya Simha · UC Davis · Operations, strategy & AI</p>
      <h1 id="hero-title" class="display hero__title">
        <span class="line">Welcome to</span>
        <span class="line"><span class="hl-magenta">Diya's</span> world.</span>
      </h1>
      <p class="hero__sub serif">
        <button class="hero__tagline" type="button" data-tagline aria-live="polite" title="Click for another">It's a little loud in here.</button>
      </p>
      <p class="hero__hint hand" aria-hidden="true">wiggle your cursor · click anywhere for sparkle · boop the lion ↗</p>
    </div>
    <a class="hero__scroll" href="#hello" aria-label="Scroll to introduction">
      <span>scroll</span>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 4v16m-6-6 6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </a>
  </section>

  <section class="hello section" id="hello">
    <div class="wrap hello__grid">
      <div class="hello__photo" data-reveal>
        <div class="polaroid">
          <Picture src={headshot} formats={['avif', 'webp']} widths={[320, 520]} sizes="(min-width: 860px) 360px, 70vw" alt="Diya smiling in a grey blazer against a stone wall" loading="lazy" />
          <p class="hand polaroid__cap">hi, it's me ↑</p>
        </div>
        <div class="stickers" aria-hidden="true">
          <span class="sticker sticker--saffron" data-sticker>est. Bangalore</span>
          <span class="sticker sticker--magenta" data-sticker>Poli Sci + Business</span>
          <span class="sticker sticker--teal" data-sticker>will sew you a tote</span>
        </div>
      </div>
      <div class="hello__text">
        <p class="eyebrow" data-reveal>The short version</p>
        <h2 class="h2" data-reveal>Driven. Passionate. <span class="serif hl-magenta">A little extra.</span></h2>
        <div data-reveal>
          <p class="lede">
            I'm Diya, a Political Science student (Business minor) at UC Davis who loves making messy, important things run smoothly.
          </p>
          <p>
            I work in operations, strategy, AI enablement and community leadership. I've led 60-person volunteer teams, untangled federal immigration backlogs with
            an eight-person consulting team, and taught 300+ people how to actually use AI at work. Off the clock I sew, draw, dance and swim, usually not at the
            same time.
          </p>
          <p class="hand hello__note">(psst: the stickers are draggable)</p>
        </div>
      </div>
    </div>
  </section>

  <Toran />

  <section class="doors section" aria-labelledby="doors-title">
    <div class="wrap">
      <p class="eyebrow" data-reveal>Rooms</p>
      <h2 id="doors-title" class="h2" data-reveal>Pick a door.</h2>
      <p class="muted doors__sub" data-reveal>Some are open. Some are still being painted.</p>
      <ul class="doors__grid" data-reveal data-reveal-stagger>
        {doors.map((d) => <Door {...d} />)}
      </ul>
    </div>
  </section>

  {
    featured && (
      <section class="featured section" aria-labelledby="featured-title">
        <div class="wrap">
          <p class="eyebrow" data-reveal>Case file #1</p>
          <a class="featured__card paper" href={`/projects/${featured.id}`} data-reveal>
            <div class="featured__img">
              <Picture src={featured.data.cover.src} formats={['avif', 'webp']} widths={[480, 800, 1200]} sizes="(min-width: 860px) 55vw, 100vw" alt={featured.data.cover.alt} loading="lazy" />
            </div>
            <div class="featured__body">
              <p class="eyebrow">{featured.data.kicker}</p>
              <h2 id="featured-title" class="featured__title">{featured.data.title}</h2>
              <p>{featured.data.summary}</p>
              <span class="btn btn--ghost">
                Open the case file <span class="arrow">→</span>
              </span>
            </div>
          </a>
        </div>
      </section>
    )
  }

  <section class="sayhi section" aria-labelledby="sayhi-title">
    <KolamBorder color="var(--saffron)" />
    <div class="wrap sayhi__inner" data-reveal>
      <h2 id="sayhi-title" class="display sayhi__title">Say <span class="serif hl-magenta">hi.</span></h2>
      <p class="lede">Founder, recruiter, fellow over-committer? I'd love to hear from you.</p>
      <a class="btn" href="/mailroom">Write to the Mailroom <span class="arrow">→</span></a>
    </div>
  </section>
</Base>

<style>
  /* ---------- intro ---------- */
  .intro {
    display: none;
  }
  :global(.show-intro) .intro {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 1rem;
    background: var(--bg);
    color: var(--magenta);
  }
  .intro__line {
    font-size: 1.6rem;
    color: var(--ink);
    margin: 0;
  }
  .intro__skip {
    position: absolute;
    bottom: 2rem;
    right: 2rem;
    background: none;
    border: 2px solid var(--ink);
    border-radius: 999px;
    padding: 0.5rem 1rem;
    font-weight: 700;
    cursor: pointer;
  }

  /* ---------- hero ---------- */
  .hero {
    position: relative;
    min-height: calc(100svh - 68px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    touch-action: pan-y;
    isolation: isolate;
  }
  .hero__field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
  }
  .hero__copy {
    padding-bottom: clamp(4rem, 12vh, 8rem);
    pointer-events: none;
  }
  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.2rem;
    color: var(--ink);
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--saffron);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--saffron) 30%, transparent);
  }
  .hero__title {
    font-size: clamp(3.4rem, 13vw, 11.5rem);
  }
  .hero__title {
    pointer-events: auto;
  }
  .hero__title .line {
    display: block;
  }
  .hero__title :global(.is-lit) {
    color: var(--lit);
    transition: color 0.15s;
  }
  .hero__sub {
    font-size: clamp(2rem, 5.5vw, 4.6rem);
    margin: 0.4rem 0 0;
    color: var(--teal);
    perspective: 600px;
  }
  .hero__tagline {
    pointer-events: auto;
    display: inline-block;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-align: left;
    cursor: pointer;
    text-decoration: underline dotted color-mix(in oklab, currentColor 35%, transparent);
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.18em;
  }
  .hero__tagline:hover {
    color: var(--magenta);
  }

  /* ---------- the lion ---------- */
  .hero__lion {
    position: absolute;
    z-index: 1;
    top: clamp(1.5rem, 7vh, 4.5rem);
    right: calc(var(--gutter) + 2vw);
    --lion-size: clamp(150px, 15vw, 210px);
    animation: lion-float 5s ease-in-out infinite;
  }
  @keyframes lion-float {
    50% {
      translate: 0 -10px;
    }
  }
  @media (max-width: 759px) {
    /* on phones the lion sits in the flow above the title, so they never overlap */
    .hero {
      flex-direction: column;
      align-items: stretch;
    }
    .hero__lion {
      position: relative;
      top: auto;
      right: auto;
      align-self: center;
      margin: 1.75rem 0 auto;
      --lion-size: 130px;
    }
  }
  .hero__hint {
    margin-top: 1.4rem;
    font-size: 1.3rem;
    color: var(--muted);
  }
  .hero__scroll {
    position: absolute;
    right: var(--gutter);
    bottom: 2rem;
    display: grid;
    justify-items: center;
    gap: 0.2rem;
    text-decoration: none;
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 700;
    animation: bob 2s ease-in-out infinite;
  }
  @keyframes bob {
    50% {
      transform: translateY(6px);
    }
  }
  @media (max-width: 759px) {
    .hero {
      align-items: flex-end;
    }
    .hero__hint {
      display: none;
    }
  }

  /* ---------- hello ---------- */
  .hello__grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }
  @media (min-width: 860px) {
    .hello__grid {
      grid-template-columns: 0.8fr 1.2fr;
    }
  }
  .hello__photo {
    position: relative;
    justify-self: center;
    width: min(100%, 360px);
  }
  .polaroid {
    background: var(--bg-2);
    padding: 12px 12px 0;
    border: 2px solid var(--ink);
    box-shadow: 8px 8px 0 var(--magenta);
    transform: rotate(-3deg);
  }
  .polaroid :global(img) {
    aspect-ratio: 4 / 5;
    object-fit: cover;
    width: 100%;
  }
  .polaroid__cap {
    color: var(--ink);
    font-size: 1.5rem;
    text-align: center;
    margin: 0.3rem 0 0.4rem;
  }
  .stickers {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .sticker {
    position: absolute;
    pointer-events: auto;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    border: 2px solid var(--ink);
    font-weight: 700;
    font-size: 0.9rem;
    white-space: nowrap;
    cursor: grab;
    touch-action: none;
    user-select: none;
    box-shadow: 3px 3px 0 var(--ink);
  }
  .sticker--saffron {
    background: var(--saffron);
    color: var(--on-saffron);
    top: -14px;
    right: -18px;
    rotate: 8deg;
  }
  .sticker--magenta {
    background: var(--magenta);
    color: #fff;
    bottom: 22%;
    left: -28px;
    rotate: -7deg;
  }
  .sticker--teal {
    background: var(--teal);
    color: #fff;
    bottom: -14px;
    right: -6px;
    rotate: 4deg;
  }
  .hello__note {
    font-size: 1.35rem;
    color: var(--teal);
  }
  .hello__text .h2 {
    margin: 0.4rem 0 1.4rem;
  }

  /* ---------- doors ---------- */
  .doors__sub {
    margin-top: 0.8rem;
  }
  .doors__grid {
    list-style: none;
    padding: 0;
    margin: 2.5rem 0 0;
    display: grid;
    gap: 1.4rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
  }

  /* ---------- featured ---------- */
  .featured__card {
    display: grid;
    margin-top: 1rem;
    text-decoration: none;
    overflow: hidden;
    box-shadow: 8px 8px 0 var(--teal);
    transition:
      transform 0.35s var(--spring),
      box-shadow 0.35s var(--spring);
  }
  .featured__card:hover {
    transform: translate(-3px, -3px) rotate(-0.5deg);
    box-shadow: 12px 12px 0 var(--teal);
  }
  @media (min-width: 860px) {
    .featured__card {
      grid-template-columns: 1.15fr 1fr;
    }
  }
  .featured__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .featured__body {
    padding: clamp(1.4rem, 3vw, 2.6rem);
    display: grid;
    align-content: center;
    gap: 0.4rem;
  }
  .featured__title {
    font-size: clamp(2.4rem, 5vw, 4.2rem);
    margin-bottom: 0.6rem;
  }
  .featured__body .btn {
    justify-self: start;
    margin-top: 0.6rem;
  }

  /* ---------- say hi ---------- */
  .sayhi__inner {
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 1rem;
    padding-top: 3rem;
  }
  .sayhi__title {
    font-size: clamp(4rem, 16vw, 12rem);
  }
</style>

<script>
  import { animate, stagger, createTimeline, createDraggable, svg, splitText } from 'animejs';
  import { initHeroField } from '../scripts/hero-field';
  import { reducedMotion } from '../scripts/motion';

  const reduced = reducedMotion();
  const canvas = document.querySelector<HTMLCanvasElement>('.hero__field')!;
  const field = initHeroField(canvas, { reduced });

  function heroEntrance() {
    if (reduced) return;
    const { chars } = splitText('.hero__title', { chars: true, accessible: true });
    animate(chars, {
      translateY: ['110%', '0%'],
      rotate: [stagger([-12, 12]), 0],
      opacity: [0, 1],
      duration: 650,
      delay: stagger(22),
      ease: 'outElastic(1, .7)',
    });
    // letters hop and flash a jewel tone when you brush over them
    const tones = ['var(--saffron)', 'var(--ruby)', 'var(--magenta)', 'var(--teal)'];
    chars.forEach((c, i) => {
      let t: number | undefined;
      c.addEventListener('pointerenter', () => {
        c.style.setProperty('--lit', tones[(Math.random() * tones.length) | 0]);
        c.classList.add('is-lit');
        clearTimeout(t);
        t = window.setTimeout(() => c.classList.remove('is-lit'), 900);
        animate(c, { translateY: [0, -26, 0], rotate: [0, (i % 2 ? 1 : -1) * 14, 0], duration: 750, ease: 'outElastic(1, .45)' });
      });
    });
    animate('.hero__lion .jlion-btn', { scale: [0, 1], rotate: [-120, 0], duration: 1100, delay: 450, ease: 'outElastic(1, .6)' });
    setTimeout(() => {
      const c = canvas.getBoundingClientRect();
      const l = document.querySelector('.hero__lion')!.getBoundingClientRect();
      field.burst(l.left + l.width / 2 - c.left, l.top + l.height / 2 - c.top, 36);
    }, 750);
    animate(['.hero__eyebrow', '.hero__sub', '.hero__hint'], {
      opacity: [0, 1],
      translateY: [20, 0],
      delay: stagger(120, { start: 350 }),
      duration: 600,
      ease: 'out(4)',
    });
    field.ripple(canvas.clientWidth * 0.7, canvas.clientHeight * 0.5);
  }

  // ----- first-visit intro (< 2s, skippable, never replays) -----
  const root = document.documentElement;
  const intro = document.getElementById('intro')!;
  if (root.classList.contains('show-intro')) {
    try {
      localStorage.setItem('dw-intro', '1');
    } catch {}
    const jewel = intro.querySelector('svg')!;
    const drawables = svg.createDrawable(jewel.querySelectorAll('path'));
    let done = false;
    const finish = () => {
      if (done) return;
      done = true;
      tl.pause();
      animate(intro, {
        opacity: [1, 0],
        scale: [1, 1.08],
        duration: 380,
        ease: 'in(2)',
        onComplete: () => {
          root.classList.remove('show-intro');
          heroEntrance();
        },
      });
    };
    const tl = createTimeline({ onComplete: finish })
      .add(drawables, { draw: ['0 0', '0 1'], duration: 900, delay: stagger(18), ease: 'inOut(2)' })
      .add('.intro__line', { opacity: [0, 1], translateY: [10, 0], duration: 300 }, 200)
      .add(jewel, { scale: [1, 1.12, 1], duration: 350, ease: 'outElastic(1, .5)' });
    intro.querySelector('[data-skip-intro]')!.addEventListener('click', finish);
    window.addEventListener('keydown', finish, { once: true });
  } else {
    heroEntrance();
  }

  // ----- the tagline shuffles when clicked -----
  const TAGLINES = [
    "It's a little loud in here.",
    'Mind the sparkle.',
    'Shoes off, chai on.',
    'Now with 40% more rhinestones.',
    'Est. Bangalore. Still expanding.',
    'Overcommitted. Overjoyed.',
    'Please do not feed the lion.',
  ];
  const tagline = document.querySelector<HTMLButtonElement>('[data-tagline]')!;
  let tagIndex = 0;
  let flipping = false;
  tagline.addEventListener('click', () => {
    if (flipping) return;
    tagIndex = (tagIndex + 1) % TAGLINES.length;
    if (reduced) {
      tagline.textContent = TAGLINES[tagIndex];
      return;
    }
    flipping = true;
    animate(tagline, {
      rotateX: [0, 90],
      opacity: [1, 0],
      duration: 180,
      ease: 'in(2)',
      onComplete: () => {
        tagline.textContent = TAGLINES[tagIndex];
        animate(tagline, {
          rotateX: [-90, 0],
          opacity: [0, 1],
          duration: 500,
          ease: 'outElastic(1, .6)',
          onComplete: () => (flipping = false),
        });
      },
    });
  });

  // ----- draggable stickers -----
  if (!reduced) {
    document.querySelectorAll<HTMLElement>('[data-sticker]').forEach((el) => {
      createDraggable(el, {
        container: document.body,
        releaseStiffness: 120,
        releaseDamping: 8,
        onGrab: (d) => animate(d.$target, { scale: 1.15, duration: 200 }),
        onRelease: (d) => animate(d.$target, { scale: 1, duration: 400, ease: 'outElastic(1, .4)' }),
      });
    });
  }
</script>
